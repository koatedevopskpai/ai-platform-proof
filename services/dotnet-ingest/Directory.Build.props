<Project>

  <!--
    NuGet lock files are committed for both projects.

    RestorePackagesWithLockFile makes restore record the resolved graph in
    packages.lock.json. CI and scripts/verify.py restore in locked mode, so a
    dependency drift fails the build instead of quietly selecting new versions.

    Regeneration instructions live in docs/architecture.md. They are kept out of
    this comment because a regeneration command contains characters that XML
    comments do not permit.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
