#!/bin/bash
# AI Platform Option A bootstrap - single always-on box.
set -euxo pipefail

# --- 1. Install Docker + git (Amazon Linux 2023) ---
dnf install -y docker git
systemctl enable --now docker
usermod -aG docker ec2-user

# --- 2. Docker Compose v2 plugin (aarch64 - t4g/t3g Graviton instances) ---
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-aarch64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# Host preparation only. Release images are built once and transported separately.
# No source checkout, git pull or on-host mutable build is supported.
dnf install -y python3
echo "HOST PREPARED; no application is deployed. Use the immutable Compose release."
